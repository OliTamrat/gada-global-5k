# Copy to .env.local and fill in. Never commit .env.local.
#
# To check what a running deployment can actually see, hit GET /api/health.
# It reports which of these are present (never their values) and returns 503
# until everything required is set.

# ── Database ─────────────────────────────────────────────────────────────────
# Any Postgres 13+ connection string. Neon, Vercel Postgres, and Supabase all
# work unchanged — nothing in the code is vendor-specific.
# Neon: https://neon.com -> sign in with GitHub -> copy the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com -> API Keys. The sending domain must be verified in Resend.
# RESEND_API is also accepted as a fallback if RESEND_API_KEY cannot be used.
RESEND_API_KEY=re_...
REGISTRATION_FROM_EMAIL="Gada Global 5K <info@gadaglobalrun.com>"
# Optional: where reply-to and support questions are directed.
REGISTRATION_REPLY_TO=info@gadaglobalrun.com

# ── Site ─────────────────────────────────────────────────────────────────────
# Used to build absolute links in confirmation emails.
NEXT_PUBLIC_SITE_URL=https://www.gadaglobalrun.com

# ── Race-day operations ──────────────────────────────────────────────────────
# Shared passcode for the start line, finish scanner, and organizer dashboard.
# Volunteers enter it once per device. Without it those screens return 503 —
# they fail closed on purpose, because an unsent wave is recoverable and a wave
# sent by a stranger is not.
RACE_OPS_PASSCODE=pick-something-memorable

# Wave sends, finish scans and the demo seeder are refused with a 423 on any
# day other than race day, so testing the start screen cannot start a real
# runner's clock. Set this to true only to rehearse deliberately — then clear
# the timing data and unset it. /api/health warns the whole time it is on.
RACE_TIMING_UNLOCKED=false

# Who gets an email on every paid registration. Comma-separated.
# Defaults to the support address if unset.
ORGANIZER_EMAILS=info@gadaglobalrun.com,gadaglobalrun@gmail.com

# ── AI race recaps (optional) ────────────────────────────────────────────────
# Without this the runner page falls back to a template-generated recap.
ANTHROPIC_API_KEY=sk-ant-...
