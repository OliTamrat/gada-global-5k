# Copy to .env.local and fill in. Never commit .env.local.

# ── Database ─────────────────────────────────────────────────────────────────
# Any Postgres 13+ connection string. Neon, Vercel Postgres, and Supabase all
# work unchanged — nothing in the code is vendor-specific.
# Neon: https://neon.com -> sign in with GitHub -> copy the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com -> API Keys. The sending domain must be verified in Resend.
RESEND_API_KEY=re_...
REGISTRATION_FROM_EMAIL="Gada Global 5K <info@gadaglobalus.com>"
# Optional: where reply-to and support questions are directed.
REGISTRATION_REPLY_TO=info@gadaglobalus.com

# ── Site ─────────────────────────────────────────────────────────────────────
# Used to build absolute links in confirmation emails.
NEXT_PUBLIC_SITE_URL=https://gadaglobalus.com

# ── AI race recaps (optional) ────────────────────────────────────────────────
# Without this the runner page falls back to a template-generated recap.
ANTHROPIC_API_KEY=sk-ant-...
