# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local data
/data/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Brochure build output — regenerate with design/brochure/build.py
design/brochure/*.html
design/brochure/*.png
design/brochure/*.pdf
design/brochure/assets/
design/letterhead/*.html
design/letterhead/*.png
design/letterhead/*.pdf
