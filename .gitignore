# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local data
/data/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated Word documents — outputs of design/letter/build.mjs. A committed
# .docx is a second copy of the offer, free to drift from src/lib/sponsors.ts.
Gada-Global-Letterhead*.docx
Gada-Global-5K-Sponsor-Letter*.docx

# Generated brochure artefacts — outputs of design/trifold/build.mjs
design/trifold/brochure.html
design/trifold/*.pdf
design/trifold/*.png
design/trifold/*.docx

# Generated letterhead artefacts — outputs of design/letterhead/build.mjs
design/letterhead/*.html
design/letterhead/*.pdf
design/letterhead/*.png
